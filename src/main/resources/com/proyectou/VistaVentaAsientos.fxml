<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane styleClass="root-pane" stylesheets="@VentasDeAsientos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyectou.VentasDeAsientosController">
   <right>
      <VBox prefHeight="619.0" prefWidth="321.0" spacing="20.0" styleClass="side-panel" BorderPane.alignment="CENTER">
         <children>
            <HBox spacing="15.0">
               <children>
                  <VBox spacing="15.0">
                     <children>
                        <Label styleClass="title-label" text="Datos de compra" />
                        <Label styleClass="text-label" text="Tipo Entrada" />
                        <Label styleClass="text-label" text="Cliente" />
                        <Button fx:id="btnComprar" mnemonicParsing="false" onAction="#coordinadorDeBoton" prefWidth="90.0" styleClass="btn-action" text="Comprar">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                  </VBox>
                  <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Pane prefHeight="25.0" /> 
                        <ComboBox fx:id="comboTipo" maxWidth="1.7976931348623157E308" styleClass="combo-box" />
                        <TextField fx:id="mensajeNombreUsuario" styleClass="modern-input" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            
            <Separator opacity="0.1" prefWidth="200.0" />
            
            <VBox spacing="15.0">
               <children>
                  <Label styleClass="title-label" text="Buscar Entrada" />
                  <HBox spacing="10.0">
                     <children>
                        <TextField maxWidth="1.7976931348623157E308" promptText="ID Entrada" styleClass="modern-input" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" styleClass="btn-action" text="Buscar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <Separator opacity="0.1" prefWidth="200.0" />
            
            <VBox spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label styleClass="title-label" text="Ticket Generado" />
                  <TextArea fx:id="txtAreaTicket" editable="false" prefHeight="200.0" prefWidth="200.0" styleClass="text-area" wrapText="true" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </children>
      </VBox>
   </right>
   
   <center>
      <VBox alignment="CENTER" spacing="30.0" BorderPane.alignment="CENTER">
         <children>
            <StackPane>
               <children>
                  <VBox alignment="CENTER" maxWidth="390.0" prefHeight="60.0" styleClass="stage-banner">
                     <children>
                        <Label text="ESCENARIO" textFill="#0a0c21">
                           <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </StackPane>

            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <VBox alignment="CENTER" spacing="19.0">
                     <children>
                        <Label styleClass="text-label" text="A" /><Label styleClass="text-label" text="B" /><Label styleClass="text-label" text="C" />
                        <Label styleClass="text-label" text="D" /><Label styleClass="text-label" text="E" /><Label styleClass="text-label" text="F" />
                        <Label styleClass="text-label" text="G" /><Label styleClass="text-label" text="H" /><Label styleClass="text-label" text="I" />
                        <Label styleClass="text-label" text="J" />
                     </children>
                  </VBox>

                  <VBox alignment="CENTER" spacing="5.0">
                     <children>
                        <HBox alignment="CENTER" spacing="39.0">
                           <children>
                              <Label styleClass="text-label" text="1" /><Label styleClass="text-label" text="2" /><Label styleClass="text-label" text="3" />
                              <Label styleClass="text-label" text="4" /><Label styleClass="text-label" text="5" /><Label styleClass="text-label" text="6" />
                              <Label styleClass="text-label" text="7" /><Label styleClass="text-label" text="8" /><Label styleClass="text-label" text="9" />
                              <Label styleClass="text-label" text="10" />
                           </children>
                           <padding><Insets bottom="5.0" /></padding>
                        </HBox>
                        
                        <GridPane fx:id="gridButacas" alignment="CENTER" hgap="5.0" vgap="5.0">
                             </GridPane>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox alignment="CENTER" spacing="40.0">
               <children>
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                            <Pane prefHeight="20.0" prefWidth="20.0" style="-fx-background-color: #1A1E3F; -fx-border-color: #2D325A; -fx-background-radius: 4;" />
                            <Label styleClass="text-label" text="Libre" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                            <Pane prefHeight="20.0" prefWidth="20.0" style="-fx-background-color: linear-gradient(to bottom right, #D4AF37, #FCECAE); -fx-background-radius: 4;" />
                            <Label styleClass="text-label" text="Selecc." />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                            <Pane prefHeight="20.0" prefWidth="20.0" style="-fx-background-color: #500a0a; -fx-background-radius: 4;" />
                            <Label styleClass="text-label" text="Reserv." />
                        </HBox>
                     </children>
                  </HBox>
                  <Button fx:id="btnReserva" onAction="#reservacion" prefWidth="120.0" styleClass="btn-action" text="Reservar">
                     <font><Font name="System Bold" size="16.0" /></font>
                  </Button>
               </children>
               <padding><Insets top="10.0" /></padding>
            </HBox>
         </children>
         <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
      </VBox>
   </center>
   
   <top>
      <StackPane>
         <children>
            <Button mnemonicParsing="false" onAction="#CerrarSesion" styleClass="btn-danger" text="← Cerrar Sesión" StackPane.alignment="TOP_LEFT" />
         </children>
         <padding><Insets left="15.0" top="15.0" /></padding>
      </StackPane>
   </top>
</BorderPane>