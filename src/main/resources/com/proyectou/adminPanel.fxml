<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #1e1e1e;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyectou.AdminPanelController">

    <!-- ================= TOP ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 12; -fx-background-color: #E6B84A;">

            <Label style="-fx-font-size: 16px;                           -fx-font-weight: bold;" text="Administración de Eventos" />

            <Region style="-fx-background-color: #E6B84A;" HBox.hgrow="ALWAYS" />

            <Button onAction="#regresarLogin" style="-fx-background-color: black;" text="Regresar" textFill="WHITE" />
        </HBox>
    </top>

    <!-- ================= CENTER ================= -->
    <center>
        <StackPane style="-fx-background-color: linear-gradient(to bottom, #1e1e1e, #2a2a2a);">

            <VBox alignment="TOP_CENTER" maxWidth="900" spacing="30" style="-fx-padding: 40; -fx-background-color: #0A0C21;">

                <!-- ===== TARJETAS SUPERIORES ===== -->
                <HBox alignment="CENTER" spacing="25">

                    <!-- Datos del Evento -->
                    <VBox prefWidth="300" spacing="10" style="-fx-background-color: #0A0C21; -fx-padding: 20; -fx-background-radius: 8;">

                        <Label style="-fx-font-weight: bold;" text="Datos del Evento" textFill="WHITE" />

                        <TextField fx:id="txtNombreEvento" promptText="Nombre del evento" />

                        <TextField fx:id="txtFechaEvento" promptText="Fecha (dd/MM/yyyy)" />

                        <TextField fx:id="txtPrecioBase" promptText="Precio base" />

                        <Button maxWidth="Infinity" onAction="#crearEvento" text="Crear Evento" />
                    </VBox>

                    <!-- Estado del Sistema -->
                    <VBox prefWidth="300" spacing="10" style="-fx-background-color: white;                                  -fx-padding: 20;                                  -fx-background-radius: 8;">

                        <Label style="-fx-font-weight: bold; -fx-background-color: white;" text="Estado del Sistema" />

                        <Label text="Aquí se puede mostrar información del evento activo," wrapText="true" />

                        <Label text="estado de la sala o mensajes administrativos." wrapText="true" />
                    </VBox>

                </HBox>

                <!-- ===== ACCIONES ===== -->
                <VBox alignment="CENTER" spacing="15" style="-fx-background-color: #0A0C21; -fx-padding: 20; -fx-background-radius: 8;">

                    <Label style="-fx-font-weight: bold;" text="Acciones Administrativas" textFill="WHITE" />

                    <HBox alignment="CENTER" spacing="15">
                        <Button onAction="#eliminarEvento" text="Eliminar Evento" />

                        <Button onAction="#reiniciarSala" text="Reiniciar Sala" />

                        <Button onAction="#verReporte" text="Ver Reporte" />
                    </HBox>
                </VBox>

            </VBox>

        </StackPane>
    </center>

</BorderPane>
